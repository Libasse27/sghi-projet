{
  "name": "sghi-project",
  "version": "1.0.0",
  "description": "Système de Gestion Hospitalière Intégré (SGHI) - Integrated Hospital Management System",
  "private": true,
  "workspaces": [
    "backend",
    "desktop",
    "mobile",
    "shared"
  ],
  "scripts": {
    "dev": "npm run backend:dev",
    "dev:all": "concurrently \"npm run backend:dev\" \"npm run desktop:dev\" \"npm run mobile:start\"",
    "backend:dev": "npm run dev --workspace=backend",
    "backend:build": "npm run build --workspace=backend",
    "backend:start": "npm run start --workspace=backend",
    "desktop:dev": "npm run dev --workspace=desktop",
    "desktop:build": "npm run build --workspace=desktop",
    "mobile:dev": "npm run start --workspace=mobile",
    "mobile:android": "npm run android --workspace=mobile",
    "mobile:ios": "npm run ios --workspace=mobile",
    "mobile:start": "npm run start --workspace=mobile",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "install:all": "npm install && npm run install --workspaces",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
