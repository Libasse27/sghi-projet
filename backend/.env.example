# ENVIRONMENT
NODE_ENV=development

# SERVER
PORT=3000
API_PREFIX=api
API_VERSION=v1

# DATABASE - PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sghi_user
POSTGRES_PASSWORD=sghi_password
POSTGRES_DB=sghi_db

# DATABASE - MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=sghi_mongo_user
MONGO_PASSWORD=sghi_mongo_password
MONGO_DB=sghi_documents
MONGO_AUTH_SOURCE=admin

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=sghi_redis_password
REDIS_TTL=3600

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:8080,http://localhost:19006
CORS_CREDENTIALS=true

# RATE LIMITING
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# FILE UPLOAD
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# EMAIL
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=noreply@sghi.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=SGHI <noreply@sghi.com>

# SMS
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+221XXXXXXXXX
ORANGE_SMS_API_KEY=your-orange-sms-key
ORANGE_SMS_API_SECRET=your-orange-sms-secret

# MOBILE MONEY
ORANGE_MONEY_API_KEY=your-orange-money-key
ORANGE_MONEY_API_SECRET=your-orange-money-secret
ORANGE_MONEY_MERCHANT_ID=your-merchant-id
WAVE_API_KEY=your-wave-key
WAVE_API_SECRET=your-wave-secret
FREE_MONEY_API_KEY=your-free-money-key
FREE_MONEY_API_SECRET=your-free-money-secret

# PAYMENT
STRIPE_PUBLIC_KEY=your-stripe-public-key
STRIPE_SECRET_KEY=your-stripe-secret-key

# STORAGE
STORAGE_PROVIDER=local
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=sghi-bucket
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret

# MONITORING
SENTRY_DSN=your-sentry-dsn

# LOGGING
LOG_LEVEL=debug
